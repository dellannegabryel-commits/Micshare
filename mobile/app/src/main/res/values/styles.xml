<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tema base do app. As cores reais são aplicadas pelo Compose
        (com.micshare.ui.theme.MicshareTheme); aqui fica apenas a moldura
        da janela, evitando o "flash" antes do Compose desenhar.
    -->
    <style name="Theme.Micshare" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/micshare_background</item>
        <item name="android:navigationBarColor">@color/micshare_background</item>
        <item name="android:windowBackground">@color/micshare_background</item>
    </style>
</resources>
