{
  "name": "@micshare/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --dev-client",
    "dev:android": "expo run:android",
    "dev:ios": "expo run:ios",
    "build:local": "eas build --local --platform all",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "prebuild": "expo prebuild --clean",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@micshare/protocol": "file:../packages/protocol",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/stack": "^7.12.1",
    "expo": "~51.0.0",
    "expo-audio": "^58.0.10",
    "expo-dev-client": "~4.0.0",
    "react": "18.2.0",
    "react-native": "0.74.0",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-udp": "^4.1.7"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.0",
    "@types/react-native": "~0.73.0",
    "typescript": "^5.4.0"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
