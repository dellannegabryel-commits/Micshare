<resources>
    <!-- Base application theme. -->
    <style name="Theme.Micshare" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/micshare_green</item>
        <item name="colorPrimaryVariant">@color/micshare_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/micshare_green_light</item>
        <item name="colorSecondaryVariant">@color/micshare_green_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/micshare_background</item>
        <item name="android:navigationBarColor">@color/micshare_background</item>
        <!-- Customize your theme here. -->
        <item name="android:windowBackground">@color/micshare_background</item>
    </style>
</resources>