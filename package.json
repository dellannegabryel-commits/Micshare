{
  "name": "micshare",
  "version": "0.1.0",
  "private": true,
  "description": "Microfone P2P em rede local — celular como microfone de entrada do PC",
  "workspaces": ["packages/*", "mobile"],
  "scripts": {
    "typecheck": "tsc --noEmit -b packages/protocol packages/pc mobile",
    "install:pc": "npm --prefix packages/pc install",
    "dev:pc": "npm --prefix packages/pc run dev"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=24"
  }
}
